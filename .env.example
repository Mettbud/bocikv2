# =============================================================================
# bocik-flip-bot - prosty profil PAPER
# Skopiuj do .env i uzupełnij dwa sekrety poniżej (puste w LIVE, niepotrzebne
# w PAPER). Ten plik nigdy nie zawiera prawdziwych kluczy.
# =============================================================================

# --- Sekrety uzupełniane wyłącznie przez właściciela -------------------------
WALLET_PRIVATE_KEY=
JUPITER_API_KEY=

# --- Solana / Jupiter ---------------------------------------------------------
RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_BASE_URL=https://lite-api.jup.ag
JUPITER_MIN_REQUEST_INTERVAL_MS=2100

# --- Token ---------------------------------------------------------------
TARGET_TOKEN_MINT=ApZuxdpzMrbEYTGEzeY9afh5pj9d6qPRJCTgQYiipbKg
TARGET_TOKEN_SYMBOL=CYBERLEEK
SOL_MINT=So11111111111111111111111111111111111111112
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- Tryb i wielkość transakcji -----------------------------------------
TRADING_MODE=paper
PAPER_BALANCE_USD=1000
# Dwa niezależne "sloty" - każdy to osobna pozycja, osobny cel, osobny PnL.
# Wielkość każdego to % aktualnego salda, które wolno wydać (saldo SOL minus
# MIN_SOL_RESERVE) - nie stała kwota w dolarach, więc rośnie/maleje razem z
# kontem w miarę zysków/strat. Ręczne "buy <usd> [a|b]" z konsoli nadal
# pozwala wymusić dokładną kwotę na jedną transakcję.
SLOT_A_SIZE_PERCENT=30
SLOT_B_SIZE_PERCENT=30
# Slot A działa samodzielnie (kup/sprzedaj/odkup na spadku - normalna
# strategia). Slot B NIGDY nie kupuje sam z siebie - kupuje wyłącznie jako
# "dobicie", gdy Slot A jest aktualnie otwarty i na stracie większej niż
# adaptacyjnie wyliczony próg (patrz DUAL_TRIGGER_* niżej). Po sprzedaży
# Slotu B, znowu czeka aż Slot A wpadnie na minus.
DUAL_SLOT_ENABLED=true
# Próg straty Slotu A liczony tak samo jak adaptacyjny cel sprzedaży:
# (typowy ostatni ruch z VOLATILITY_LOOKBACK_MS) * mnożnik, przycięty do
# [MIN, MAX]. Trzymaj MAX poniżej STOP_LOSS_PERCENT, inaczej Slot A dostanie
# stop-lossa zanim Slot B zdąży zareagować.
DUAL_TRIGGER_MULTIPLIER=1
DUAL_TRIGGER_MIN_PERCENT=3
DUAL_TRIGGER_MAX_PERCENT=20
MIN_SOL_RESERVE=0.05

# --- Strategia flip: kup taniej, sprzedaj drożej, odkup po spadku -------
# Cel brutto: sprzedajemy dopiero gdy cena jest o tyle % wyżej niż cena zakupu.
# Używany wprost gdy ADAPTIVE_TARGET_ENABLED=false, i jako wartość zapasowa,
# dopóki bot nie zbierze wystarczająco dużo historii ceny na żywo.
TARGET_GAIN_PERCENT=6
# Gdy włączone: każde nowe kupno samo liczy sobie cel sprzedaży na podstawie
# tego, jak token faktycznie się ostatnio rusza (VOLATILITY_LOOKBACK_MS
# minut historii z pamięci) - zamiast sztywnego TARGET_GAIN_PERCENT powyżej.
# Cel jest zamrażany w momencie zakupu i nie zmienia się w trakcie trzymania
# pozycji - tylko kolejne kupno liczy swój własny.
ADAPTIVE_TARGET_ENABLED=true
VOLATILITY_LOOKBACK_MS=300000
# Cel = (typowy ostatni ruch w oknie powyżej) * ten mnożnik.
ADAPTIVE_TARGET_MULTIPLIER=1.5
# Twardy dół/góra na adaptacyjny cel - niezależnie od realnego kosztu rundy,
# który i tak jest sprawdzany na żywo przed każdą faktyczną transakcją.
ADAPTIVE_TARGET_MIN_PERCENT=3
ADAPTIVE_TARGET_MAX_PERCENT=15
# Po odjęciu realnych kosztów rundy (spread/impact + opłaty sieciowe) transakcja
# musi zostawić przynajmniej tyle % czystego zysku, inaczej bot czeka dalej.
MIN_NET_PROFIT_PERCENT=2
# O ile % poniżej ostatniej ceny sprzedaży cena musi spaść, zanim odkupimy.
# 0 = odkup od razu gdy cena jest poniżej ceny ostatniej sprzedaży.
REBUY_DROP_PERCENT=0
# Jeżeli aktualnie szacowany koszt rundy (kup+sprzedaj) przekracza ten %,
# bot w ogóle nie handluje w tym ticku - płynność/spread są za słabe.
MAX_ROUND_TRIP_COST_PERCENT=4

MAX_SLIPPAGE_BPS=150
MAX_PRICE_IMPACT_BPS=250
# Bazowy spread puli, mierzony na małej, stałej kwocie referencyjnej (round
# trip tam i z powrotem) - niezależny od wielkości NASZEJ transakcji. Gdy
# pula jest w danym momencie za "cienka" (szeroki spread), bot w ogóle nie
# handluje, bez względu na to, jak mała byłaby transakcja. 100 = 1%.
MAX_SPREAD_BPS=100

# Siatka bezpieczeństwa, niezależna od strategii flip - 0 wyłącza.
STOP_LOSS_PERCENT=25

# --- Wykonanie transakcji -------------------------------------------------
PRIORITY_LEVEL=medium
PRIORITY_MAX_LAMPORTS=1000000

# --- Monitoring ceny --------------------------------------------------------
PRICE_POLL_INTERVAL_MS=5000
PRICE_REFERENCE_SOL_AMOUNT=0.01
DASHBOARD_REFRESH_MS=1000

# --- Logi / stan -------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=./data/bot.log
STATE_FILE=./data/state.json
TRADES_CSV=./data/trades.csv
DRY_RUN_LOG_SKIPS=true
