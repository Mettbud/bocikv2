# =============================================================================
# bocik-flip-bot - "wersja C" do porównania A/B/C z głównym .env
# Skopiuj do .env.c (nie do .env!), uzupełnij dwa sekrety, i odpal:
#   DOTENV_CONFIG_PATH=.env.c npm run bot        (Linux/Mac)
#   $env:DOTENV_CONFIG_PATH=".env.c"; npm run bot (Windows PowerShell)
# Różnice względem .env.example: SLOT_C_ENABLED=true (testujemy trzeci,
# głębszy poziom "dobicia" - drabinkę DCA pod Slotem B) oraz osobne
# LOG_FILE/STATE_FILE/TRADES_CSV, żeby ta instancja nie nadpisywała danych
# wersji A ani B podczas równoległej pracy.
# Ten plik nigdy nie zawiera prawdziwych kluczy.
# =============================================================================

# --- Sekrety uzupełniane wyłącznie przez właściciela -------------------------
WALLET_PRIVATE_KEY=
JUPITER_API_KEY=

# --- Solana / Jupiter ---------------------------------------------------------
RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_BASE_URL=https://lite-api.jup.ag
JUPITER_MIN_REQUEST_INTERVAL_MS=2100

# --- Token ---------------------------------------------------------------
TARGET_TOKEN_MINT=ApZuxdpzMrbEYTGEzeY9afh5pj9d6qPRJCTgQYiipbKg
TARGET_TOKEN_SYMBOL=CYBERLEEK
SOL_MINT=So11111111111111111111111111111111111111112
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- Tryb i wielkość transakcji -----------------------------------------
TRADING_MODE=paper
PAPER_BALANCE_USD=1000
# Dwa niezależne "sloty" - każdy to osobna pozycja, osobny cel, osobny PnL.
# Wielkość każdego to STAŁY % salda STARTOWEGO (PAPER_BALANCE_USD w trybie
# paper, albo to co portfel ma w momencie pierwszego uruchomienia w trybie
# live) - NIE % aktualnego salda. Przy $1000 na start i 30% każdy slot
# zawsze celuje w $300, niezależnie czy konto ma teraz $1200 czy $600 -
# nic się nie kompounduje automatycznie. Ręczne "buy [usd] [a|b|c]" z konsoli
# nadal pozwala wymusić dokładną kwotę na jedną transakcję.
SLOT_A_SIZE_PERCENT=30
SLOT_B_SIZE_PERCENT=30
# Slotu C rozmiar - tylko gdy SLOT_C_ENABLED=true (patrz niżej). Mniejszy niż
# A/B domyślnie, bo to trzeci, jeszcze głębszy poziom dobicia.
SLOT_C_SIZE_PERCENT=20
# Slot A działa samodzielnie (kup/sprzedaj/odkup na spadku - normalna
# strategia). Slot B NIGDY nie kupuje sam z siebie - kupuje wyłącznie jako
# "dobicie", gdy Slot A jest aktualnie otwarty i na stracie większej niż
# adaptacyjnie wyliczony próg (patrz DUAL_TRIGGER_* niżej). Po sprzedaży
# Slotu B, znowu czeka aż Slot A wpadnie na minus.
DUAL_SLOT_ENABLED=true
# Próg straty Slotu A liczony tak samo jak adaptacyjny cel sprzedaży:
# (typowy ostatni ruch z VOLATILITY_LOOKBACK_MS) * mnożnik, przycięty do
# [MIN, MAX]. Trzymaj MAX poniżej STOP_LOSS_PERCENT, inaczej Slot A dostanie
# stop-lossa zanim Slot B zdąży zareagować.
DUAL_TRIGGER_MULTIPLIER=1
DUAL_TRIGGER_MIN_PERCENT=3
DUAL_TRIGGER_MAX_PERCENT=20
# Opcjonalny (WYŁĄCZONY domyślnie) trzeci, jeszcze głębszy poziom "dobicia" -
# drabinka DCA pod Slotem B. Slot C kupuje wyłącznie, gdy Slot A jest na
# stracie większej niż WŁASNY (głębszy) próg Slotu C - niezależnie od tego,
# czy Slot B akurat trzyma pozycję (Slot B lata w kółko na swoim własnym
# cyklu). Działa dobrze na rynku, który faktycznie odbija się od dna
# (głębszy dołek = lepsza cena wejścia), ale w realnym trendzie spadkowym
# dokłada kolejną porcję kapitału na kolejnej stracie - w najgorszym razie
# A+B+C są otwarte jednocześnie. Trzymaj SLOT_C_SIZE_PERCENT mniejszy niż
# A/B, i SLOT_C_TRIGGER_MAX_PERCENT poniżej STOP_LOSS_PERCENT. Przetestuj
# najpierw na osobnej, trzeciej konfiguracji (patrz README, sekcja o
# porównaniu A/B/C) zanim włączysz na głównym koncie.
SLOT_C_ENABLED=true
SLOT_C_TRIGGER_MULTIPLIER=2
SLOT_C_TRIGGER_MIN_PERCENT=10
SLOT_C_TRIGGER_MAX_PERCENT=22
# Tak samo jak SLOT_B_TRAILING_STOP_* - Slot C też może uzbrajać się przy
# mniejszym ruchu niż Slot A.
SLOT_C_TRAILING_STOP_ARM_PERCENT=4
SLOT_C_TRAILING_STOP_PERCENT=2
MIN_SOL_RESERVE=0.05

# --- Strategia flip: kup taniej, sprzedaj drożej, odkup po spadku -------
# Cel brutto: sprzedajemy dopiero gdy cena jest o tyle % wyżej niż cena zakupu.
# Używany wprost gdy ADAPTIVE_TARGET_ENABLED=false, i jako wartość zapasowa,
# dopóki bot nie zbierze wystarczająco dużo historii ceny na żywo.
TARGET_GAIN_PERCENT=6
# Gdy włączone: każde nowe kupno samo liczy sobie cel sprzedaży na podstawie
# tego, jak token faktycznie się ostatnio rusza (VOLATILITY_LOOKBACK_MS
# minut historii z pamięci) - zamiast sztywnego TARGET_GAIN_PERCENT powyżej.
# Cel jest zamrażany w momencie zakupu i nie zmienia się w trakcie trzymania
# pozycji - tylko kolejne kupno liczy swój własny.
ADAPTIVE_TARGET_ENABLED=true
VOLATILITY_LOOKBACK_MS=300000
# Cel = (typowy ostatni ruch w oknie powyżej) * ten mnożnik.
ADAPTIVE_TARGET_MULTIPLIER=1.5
# Twardy dół/góra na adaptacyjny cel - niezależnie od realnego kosztu rundy,
# który i tak jest sprawdzany na żywo przed każdą faktyczną transakcją.
ADAPTIVE_TARGET_MIN_PERCENT=3
ADAPTIVE_TARGET_MAX_PERCENT=15
# Po odjęciu realnych kosztów rundy (spread/impact + opłaty sieciowe) transakcja
# musi zostawić przynajmniej tyle % czystego zysku, inaczej bot czeka dalej.
MIN_NET_PROFIT_PERCENT=2
# O ile % poniżej ostatniej ceny sprzedaży cena musi spaść, zanim odkupimy.
# 0 = odkup od razu gdy cena jest poniżej ceny ostatniej sprzedaży.
REBUY_DROP_PERCENT=0
# Jeżeli aktualnie szacowany koszt rundy (kup+sprzedaj) przekracza ten %,
# bot w ogóle nie handluje w tym ticku - płynność/spread są za słabe.
MAX_ROUND_TRIP_COST_PERCENT=4
# Gdy true: pierwsze-w-historii wejście Slotu A (nie ma jeszcze żadnej
# zapisanej ostatniej sprzedaży) NIGDY nie kupuje automatycznie - czeka na
# ręczną komendę "buy" w konsoli. Każdy kolejny odkup po zamknięciu tej
# pierwszej pozycji znowu działa w pełni automatycznie (na podstawie
# zapisanej ostatniej ceny sprzedaży), bez zmian.
SLOT_A_REQUIRE_MANUAL_FIRST_BUY=true
# Trailing stop: zabezpiecza zysk, gdy pozycja weszła realnie na plus, a
# potem się cofa - zamiast czekać w nieskończoność na pełny cel (który na
# rynku bocznym może nigdy nie nadejść). Uzbraja się dopiero gdy szczyt od
# wejścia osiągnie TRAILING_STOP_ARM_PERCENT zysku; potem sprzedaje, gdy
# cena spadnie TRAILING_STOP_PERCENT poniżej tego szczytu - nadal musi
# przejść przez MIN_NET_PROFIT_PERCENT jak każda inna sprzedaż.
TRAILING_STOP_ENABLED=true
TRAILING_STOP_ARM_PERCENT=4
TRAILING_STOP_PERCENT=2
# Slot B istnieje po to, żeby szybko "flipować" podczas gdy Slot A jest pod
# wodą - w wąskim, bocznym paśmie, które nigdy nie przebija
# TRAILING_STOP_ARM_PERCENT, pozycja Slotu B może stać w nieskończoność (ani
# cel, ani powyższy trailing stop nie zadziała bez realnego ruchu na plus -
# i żaden z nich nigdy nie sprzeda na stracie tylko dlatego że to lokalny
# szczyt, bo złamałoby to MIN_NET_PROFIT_PERCENT). Te dwa ustawienia
# pozwalają Slotowi B uzbrajać się/reagować przy mniejszych ruchach niż Slot
# A, żeby łapał nawet drobne odbicia zamiast czekać na większy ruch, którego
# wąskie pasmo może nigdy nie dać. Domyślnie takie same jak dla Slotu A (brak
# zmiany zachowania), dopóki nie obniżysz ich specjalnie dla Slotu B.
SLOT_B_TRAILING_STOP_ARM_PERCENT=4
SLOT_B_TRAILING_STOP_PERCENT=2
# "Szczyt" to cena z JEDNEGO ticku (co PRICE_POLL_INTERVAL_MS) - chwilowy
# spike wygląda tak samo jak prawdziwy ruch. Gdy > 0, cofnięcie od szczytu
# musi utrzymać się przez tyle ms (kilka ticków z rzędu), zanim bot
# faktycznie sprzeda - odfiltrowuje pojedynczy szum. 0 = sprzedaj natychmiast
# przy pierwszym ticku spełniającym warunek.
TRAILING_STOP_CONFIRMATION_MS=4000
# Na zmiennym rynku wymóg, żeby cofnięcie trzymało się DOKŁADNIE za progiem
# na KAŻDYM ticku, rzadko przetrwa te kilka sekund - jeden tick cofający się
# o ułamek % zerowałby cały licznik. Ten % rozluźnia próg (tylko po to, żeby
# nie zerować licznika przy drobnym odbiciu) - realna sprzedaż nadal wymaga
# przejścia przez prawdziwy, nierozluźniony próg TRAILING_STOP_PERCENT.
TRAILING_STOP_CONFIRMATION_TOLERANCE_PERCENT=0.5
# Opcjonalne (WYŁĄCZONE domyślnie) - normalna zasada Slotu A to "nigdy nie
# kupuj drożej niż ostatnia sprzedaż". Jeśli token po prostu rośnie bez
# przerwy i nigdy nie wraca do tego poziomu, Slot A zostaje w gotówce i
# przegapia cały ruch. Gdy włączone, Slot A DODATKOWO kupuje na
# potwierdzonym cofnięciu w ramach wybicia powyżej ostatniej sprzedaży -
# śledzi szczyt ruchu w górę i kupuje, gdy cena spadnie o wyliczony %
# poniżej tego szczytu (ta sama matematyka co adaptacyjny cel/trailing
# stop, tylko dla kupna). To realna zmiana strategii (kupowanie w siłę,
# nie tylko w dołki) - zostaw wyłączone na głównej konfiguracji i
# przetestuj najpierw równolegle (patrz README, sekcja o porównaniu A/B).
BREAKOUT_BUY_ENABLED=false
BREAKOUT_BUY_MULTIPLIER=0.5
BREAKOUT_BUY_MIN_PERCENT=2
BREAKOUT_BUY_MAX_PERCENT=10
BREAKOUT_BUY_CONFIRMATION_MS=4000
# Ten sam pomysł co TRAILING_STOP_CONFIRMATION_TOLERANCE_PERCENT, dla
# potwierdzenia cofnięcia przy breakout buy.
BREAKOUT_BUY_CONFIRMATION_TOLERANCE_PERCENT=0.5

MAX_SLIPPAGE_BPS=150
MAX_PRICE_IMPACT_BPS=250
# Bazowy spread puli, mierzony na małej, stałej kwocie referencyjnej (round
# trip tam i z powrotem) - niezależny od wielkości NASZEJ transakcji. Gdy
# pula jest w danym momencie za "cienka" (szeroki spread), bot w ogóle nie
# handluje, bez względu na to, jak mała byłaby transakcja. 100 = 1%.
MAX_SPREAD_BPS=100

# Siatka bezpieczeństwa, niezależna od strategii flip - 0 wyłącza.
STOP_LOSS_PERCENT=25

# --- Wykonanie transakcji -------------------------------------------------
PRIORITY_LEVEL=medium
PRIORITY_MAX_LAMPORTS=1000000

# --- Monitoring ceny --------------------------------------------------------
PRICE_POLL_INTERVAL_MS=5000
PRICE_REFERENCE_SOL_AMOUNT=0.01
DASHBOARD_REFRESH_MS=1000

# --- Logi / stan -------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=./data/bot-c.log
STATE_FILE=./data/state-c.json
TRADES_CSV=./data/trades-c.csv
DRY_RUN_LOG_SKIPS=true
